"""Run ``ghdl --file-to-xml`` on VHDL sources.

This is the analyzed IR that Verilator's VHDL frontend lowers.  Use it to inspect
GHDL's resolved references (``implementation``, ``named_entity``, ``type``) when a
Verilator diagnostic points at a node the lowering does not recognize.

Examples:
  nodist/ghdl_xml design.vhdl > design.xml
  nodist/ghdl_xml --std 93 -o design.xml design.vhdl
  VERILATOR_GHDL=/path/to/ghdl nodist/ghdl_xml design.vhdl | less
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile


def main():
    """Command-line entry point."""
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('files', nargs='+', help='VHDL source files')
    parser.add_argument('--ghdl',
                        default=os.environ.get('VERILATOR_GHDL', 'ghdl'),
                        help='GHDL executable (default: $VERILATOR_GHDL or ghdl)')
    parser.add_argument('--std', default='08', help='VHDL standard (default: 08)')
    parser.add_argument('--workdir',
                        default=None,
                        help='GHDL work directory (default: a temporary directory)')
    parser.add_argument('-o', '--output', default=None, help='write XML here instead of stdout')
    args = parser.parse_args()

    workdir = args.workdir
    cleanup = False
    if not workdir:
        workdir = tempfile.mkdtemp(prefix='ghdl_xml_')
        cleanup = True
    try:
        cmd = [
            args.ghdl,
            '--file-to-xml',
            f'--std={args.std}',
            f'--workdir={workdir}',
        ] + args.files
        result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        sys.stderr.buffer.write(result.stderr)
        if result.returncode != 0:
            return result.returncode
        if args.output:
            with open(args.output, 'wb') as f:
                f.write(result.stdout)
        else:
            sys.stdout.buffer.write(result.stdout)
        return 0
    finally:
        if cleanup:
            shutil.rmtree(workdir, ignore_errors=True)


if __name__ == '__main__':
    sys.exit(main())
